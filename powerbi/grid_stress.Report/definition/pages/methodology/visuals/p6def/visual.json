                      "fontSize": "9pt",
                      "fontFamily": "Segoe UI",
                      "color": "#1B2A38"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Ramp stress hour",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "fontFamily": "Segoe UI",
                      "color": "#123A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Top 5% of absolute hour-over-hour change in net load, where net load is demand minus solar and wind. Overlaps demand-stress hours by 5 to 12%.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontFamily": "Segoe UI",
                      "color": "#1B2A38"
